Bundle-Name: Gecko bnd Update
Bundle-Description: Finds newer versions of the libraries in a bnd workspace's Maven \
	repositories and matches them against vulnerability reports (Trivy), within a version \
	policy. A plain Java library on top of bnd, usable standalone; CLI, build plugins and CI \
	adapters wrap it.

Export-Package: \
	org.gecko.bnd.update;version=${base-version},\
	org.gecko.bnd.update.maven;version=${base-version},\
	org.gecko.bnd.update.report;version=${base-version}

# A standalone library: whoever uses it outside bnd (the Maven plugin, a service, a test) needs
# bndlib and the Maven repository support at runtime, so they are compile dependencies of its
# POM - unlike the SBOM exporter, a bnd plugin, whose runtime bnd itself is.

-buildpath: \
	biz.aQute.bndlib;version=latest,\
	biz.aQute.repository;version=latest,\
	biz.aQute.resolve;version=latest,\
	biz.aQute.bnd.util;version=latest,\
	aQute.libg;version=latest,\
	osgi.core;version=latest,\
	org.osgi.service.repository;version=latest,\
	org.osgi.service.resolver;version=latest,\
	slf4j.api;version=latest

-testpath: \
	assertj-core;version=latest,\
	org.osgi.util.function;version=latest,\
	org.osgi.util.promise;version=latest

# The fennec library's default build path (annotations), as provided: they have CLASS retention
# and are not needed at runtime (docs/maven-scopes.md, rule 1).
-buildpath.base: \
	org.osgi.annotation.versioning;maven-scope=provided,\
	org.osgi.annotation.bundle;maven-scope=provided,\
	org.osgi.service.component.annotations;maven-scope=provided,\
	org.osgi.service.metatype.annotations;maven-scope=provided
