# The exporter's own runtime: this bundle and what it needs from bnd, resolved like an
# application. './gradlew :org.gecko.bnd.sbom:sbom' writes its SBOM with the exporter built in
# this project, and the CI hands that SBOM to Trivy.

-runfw: org.apache.felix.framework
-runee: JavaSE-21

-runrequires: \
	bnd.identity;id='org.gecko.bnd.sbom'

# The exporter is not registered in the workspace: its jar does not exist before this project is
# built. Registered here, bnd loads it only when the export runs, after the jar task.
-plugin.sbom: \
	org.gecko.bnd.sbom.SbomExporter;\
		path:="${.}/generated/org.gecko.bnd.sbom.jar"

-sbom: level=medium, format=cyclonedx
-runbundles: \
	aQute.libg;version='[7.4.0,7.4.1)',\
	biz.aQute.bnd.util;version='[7.4.0,7.4.1)',\
	biz.aQute.bndlib;version='[7.4.0,7.4.1)',\
	org.apache.aries.spifly.dynamic.framework.extension;version='[1.3.7,1.3.8)',\
	org.gecko.bnd.sbom;version=snapshot,\
	org.osgi.service.repository;version='[1.1.0,1.1.1)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)'