# runtime.bndrun as CycloneDX 1.7, so that CI validates this output format against its schema as well
# (sbom.yml). The leading ~ keeps the -sbom below instead of the included one.
-include: ~${.}/runtime.bndrun

-sbom: level=medium, format=cyclonedx, cyclonedx.version=1.7, property.vcs:commit=${env;GITHUB_SHA;local}
-runbundles: \
	aQute.libg;version='[7.4.0,7.4.1)',\
	biz.aQute.bnd.util;version='[7.4.0,7.4.1)',\
	biz.aQute.bndlib;version='[7.4.0,7.4.1)',\
	org.apache.aries.spifly.dynamic.framework.extension;version='[1.3.8,1.3.9)',\
	org.gecko.bnd.sbom;version=snapshot,\
	org.osgi.service.repository;version='[1.1.0,1.1.1)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	slf4j.api;version='[2.0.20,2.0.21)',\
	slf4j.simple;version='[2.0.20,2.0.21)'