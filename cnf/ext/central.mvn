# bnd itself: the exporter is a bnd plugin and compiles against bndlib
biz.aQute.bnd:aQute.libg:${bndversion}
biz.aQute.bnd:biz.aQute.bndlib:${bndversion}
biz.aQute.bnd:biz.aQute.bnd.util:${bndversion}
biz.aQute.bnd:biz.aQute.bnd.annotation:${bndversion}
biz.aQute.bnd:biz.aQute.repository:${bndversion}
biz.aQute.bnd:biz.aQute.bnd.embedded-repo:${bndversion}

# default -buildpath of the fennec library
org.osgi:org.osgi.annotation.versioning:1.1.2
org.osgi:org.osgi.annotation.bundle:2.0.0
org.osgi:org.osgi.service.component.annotations:1.5.1
org.osgi:org.osgi.service.metatype.annotations:1.4.1
org.osgi:osgi.core:8.0.0
org.slf4j:slf4j-api:2.0.17

# test
org.assertj:assertj-core:3.27.7

# workspace library
org.eclipse.fennec.bnd:org.eclipse.fennec.bnd.library:0.0.9

# framework for runtime.bndrun (SBOM of the exporter's own runtime, see org.gecko.bnd.sbom/build.gradle)
org.apache.felix:org.apache.felix.framework:7.0.5
# what bndlib needs at runtime besides the framework
org.osgi:org.osgi.service.repository:1.1.0
org.osgi:org.osgi.util.function:1.2.0
org.osgi:org.osgi.util.promise:1.3.0
org.slf4j:slf4j-simple:2.0.17
# slf4j 2 finds its backend through the ServiceLoader Mediator
org.apache.aries.spifly:org.apache.aries.spifly.dynamic.framework.extension:1.3.7
# bnd's repositories need them at runtime (bnd update CLI)
org.osgi:org.osgi.service.coordinator:1.0.2
org.osgi:org.osgi.service.log:1.5.0
